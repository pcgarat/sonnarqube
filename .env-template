# ============================================
# SonarQube Docker Compose - Configuración
# ============================================
# Copia este archivo a .env y ajusta los valores según tus necesidades
# cp .env-template .env

# ============================================
# Nombre del proyecto Docker Compose
# ============================================
COMPOSE_PROJECT_NAME=sonarqube

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_VERSION=15-alpine
POSTGRES_USER=sonar
POSTGRES_PASSWORD=sonar
POSTGRES_DB=sonar
POSTGRES_PORT=5432

# ============================================
# SonarQube Configuration
# ============================================
SONARQUBE_VERSION=lts-community
SONARQUBE_PORT=9000

# Credenciales por defecto de SonarQube (cambiar después del primer login)
SONARQUBE_ADMIN_USER=admin
SONARQUBE_ADMIN_PASSWORD=admin

# Configuración de memoria JVM para SonarQube
# Ajusta según los recursos de tu máquina
# Formato: -Xmx<size> -Xms<size>
# Ejemplo: -Xmx2g -Xms512m para 2GB máximo y 512MB inicial
SONAR_WEB_JAVAADDITIONALOPTS=-Xmx512m -Xms128m

# Deshabilitar checks de Elasticsearch para desarrollo local
SONAR_ES_BOOTSTRAP_CHECKS_DISABLE=true

# ============================================
# SonarScanner Configuration
# ============================================
SONAR_SCANNER_VERSION=latest

# Directorio raíz donde están tus proyectos (ruta absoluta o relativa)
# Este directorio se montará en el contenedor del scanner
PROJECTS_ROOT=./projects

# URL del servidor SonarQube (usado por el scanner)
SONAR_HOST_URL=http://localhost:9000

# ============================================
# Configuración de Red
# ============================================
# Nombre de la red Docker (por defecto se crea automáticamente)
# NETWORK_NAME=sonarqube-network

# ============================================
# Configuración Adicional
# ============================================
# Timezone (opcional)
# TZ=Europe/Madrid

# ============================================
# Notas de Seguridad
# ============================================
# IMPORTANTE: Cambia las contraseñas por defecto en producción
# - POSTGRES_PASSWORD: Contraseña de PostgreSQL
# - SONARQUBE_ADMIN_PASSWORD: Contraseña del admin de SonarQube (cambiar desde la UI)
#
# Para cambiar la contraseña de admin en SonarQube:
# 1. Accede a http://localhost:9000
# 2. Login con admin/admin
# 3. Ve a My Account > Security > Change password

